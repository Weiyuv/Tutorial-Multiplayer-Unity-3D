
/* FUNDO GERAL */

#MainContainer {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: rgb(239, 237, 225);
    align-items: center;
    justify-content: center;
    padding: 35px;
}

/* MENU PRINCIPAL */

#MainHeader {
    width: 700px;
    margin-bottom: 28px;
}

#Title {
    color: rgb(34, 62, 54);
    font-size: 48px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    letter-spacing: 2px;
}

.Subtitle {
    color: rgb(100, 112, 99);
    font-size: 20px;
    margin-top: 8px;
}

#MenuButtons {
    width: 700px;
    align-items: stretch;
}

Button {
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.MenuCard {
    width: 100%;
    height: 112px;
    margin-bottom: 16px;
    padding: 14px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(255, 255, 255);
    border-width: 2px;
    border-color: rgb(215, 216, 203);
    border-radius: 16px;
}

.MenuCard:hover {
    background-color: rgb(230, 241, 231);
    border-color: rgb(23, 107, 91);
}

.MenuCard:focus {
    border-width: 4px;
    border-color: rgb(201, 111, 56);
}

.MenuCard:active {
    background-color: rgb(215, 233, 219);
}

.PlayCard {
    background-color: rgb(23, 107, 91);
    border-color: rgb(23, 107, 91);
}

.PlayCard:hover {
    background-color: rgb(32, 128, 107);
    border-color: rgb(32, 128, 107);
}

.PlayCard:focus {
    border-width: 4px;
    border-color: rgb(201, 111, 56);
}

.PlayCard .CardTitle,
.PlayCard .CardDescription,
.PlayCard .CardArrow {
    color: white;
}

.CardIcon {
    width: 76px;
    height: 76px;
    min-width: 76px;
    border-radius: 14px;
    align-items: center;
    justify-content: center;
    margin-right: 20px;
}

.PlayIcon {
    background-color: rgb(255, 255, 255);
}

.SettingsIcon {
    background-color: rgb(220, 237, 226);
}

.ExitIcon {
    background-color: rgb(248, 229, 215);
}

.IconText {
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(23, 107, 91);
}

.ExitIcon .IconText {
    color: rgb(172, 83, 43);
    font-size: 44px;
}

.CardText {
    flex-grow: 1;
    align-items: flex-start;
    justify-content: center;
}

.CardTitle {
    color: rgb(35, 61, 53);
    font-size: 25px;
    -unity-font-style: bold;
}

.CardDescription {
    color: rgb(100, 112, 99);
    font-size: 18px;
    margin-top: 5px;
}

.CardArrow {
    color: rgb(23, 107, 91);
    font-size: 42px;
    margin-left: 12px;
    margin-right: 12px;
}

/* PAINEL DE CONFIGURAÇÕES */

#SettingsPanel {
    display: none;
    width: 1100px;
    height: 92%;
    max-height: 92%;
    flex-direction: column;
    padding: 25px;
    background-color: rgb(255, 255, 255);
    border-width: 2px;
    border-color: rgb(211, 215, 201);
    border-radius: 18px;
    flex-shrink: 1;
}

#SettingsHeader {
    margin-bottom: 18px;
    padding-bottom: 16px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(230, 232, 222);
}

#SettingsTitle {
    color: rgb(34, 62, 54);
    font-size: 36px;
    -unity-font-style: bold;
}

.SettingsSubtitle {
    color: rgb(105, 115, 102);
    font-size: 18px;
    margin-top: 5px;
}

/* CORPO DIVIDIDO */

#SettingsBody {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

#SettingsSidebar {
    width: 220px;
    min-width: 220px;
    padding: 15px;
    margin-right: 20px;
    background-color: rgb(239, 244, 235);
    border-radius: 12px;
}

.SidebarHeading {
    color: rgb(100, 112, 99);
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 18px;
}

.SidebarItem {
    height: 58px;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    margin-bottom: 10px;
    border-radius: 9px;
    background-color: rgb(255, 255, 255);
}

.ActiveSidebarItem {
    background-color: rgb(23, 107, 91);
}

.SidebarIcon {
    color: rgb(23, 107, 91);
    font-size: 25px;
    margin-right: 12px;
}

.ActiveSidebarItem .SidebarIcon {
    color: white;
}

.SidebarText {
    color: rgb(35, 61, 53);
    font-size: 17px;
    -unity-font-style: bold;
}

.ActiveSidebarItem .SidebarText {
    color: white;
}

.SidebarHelp {
    margin-top: 25px;
    padding: 12px;
    background-color: rgb(250, 232, 211);
    border-radius: 9px;
}

.HelpTitle {
    color: rgb(151, 82, 42);
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.HelpText {
    color: rgb(74, 66, 53);
    font-size: 15px;
}

/* ÁREA DE CONTEÚDO */

.SettingsScroll {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    background-color: rgb(255, 255, 255);
}

.SettingsCard {
    padding: 18px;
    margin-bottom: 15px;
    background-color: rgb(248, 248, 243);
    border-width: 1px;
    border-color: rgb(224, 227, 216);
    border-radius: 12px;
}

.SectionTitle {
    color: rgb(23, 107, 91);
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 15px;
}

.OptionLabel {
    color: rgb(48, 58, 52);
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

/* VOLUME */

#VolumeSlider {
    width: 100%;
    height: 38px;
    margin-bottom: 5px;
}

#VolumeValue {
    color: rgb(185, 91, 35);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

/* CONTROLES */

.ControlRow {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 57px;
    margin-bottom: 8px;
    padding: 8px 12px;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(225, 228, 218);
    border-radius: 9px;
}

.ControlName {
    flex-grow: 1;
    color: rgb(35, 61, 53);
    font-size: 19px;
    -unity-font-style: bold;
}

.BindingButton {
    width: 165px;
    min-width: 165px;
    height: 45px;
    margin: 0;
    background-color: rgb(23, 107, 91);
    color: white;
    font-size: 18px;
    border-width: 0;
    border-radius: 8px;
}

.BindingButton:hover {
    background-color: rgb(32, 128, 107);
}

.BindingButton:focus {
    border-width: 3px;
    border-color: rgb(201, 111, 56);
}

/* RODAPÉ E BOTÃO VOLTAR */

#SettingsFooter {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    padding-top: 15px;
    margin-top: 12px;
    border-top-width: 2px;
    border-top-color: rgb(230, 232, 222);
}

#BackButton {
    width: 220px;
    height: 62px;
    margin: 0;
    background-color: rgb(201, 111, 56);
    color: white;
    font-size: 21px;
    border-width: 0;
    border-radius: 10px;
}

#BackButton:hover {
    background-color: rgb(174, 88, 39);
}

#BackButton:focus {
    border-width: 4px;
    border-color: rgb(35, 61, 53);
}

#BackButton:active {
    background-color: rgb(145, 70, 30);
}
