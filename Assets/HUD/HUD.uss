
.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.player-panel {
    position: absolute;
    left: 35px;
    bottom: 35px;
    width: 300px;
    padding: 8px;
    background-color: rgba(8, 18, 32, 0.88);
    border-left-width: 3px;
    border-left-color: rgb(40, 180, 255);
}

.health-track {
    width: 100%;
    height: 15px;
    background-color: rgb(35, 43, 55);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgb(75, 100, 120);
    border-bottom-color: rgb(75, 100, 120);
    border-left-color: rgb(75, 100, 120);
    border-right-color: rgb(75, 100, 120);
    overflow: hidden;
}

.health-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(35, 200, 235);
}

.enemy-panel {
    position: absolute;
    top: 30px;
    left: 50%;
    translate: -50% 0;
    width: 420px;
    padding: 8px 12px;
    align-items: center;
    background-color: rgba(8, 18, 32, 0.9);
    border-bottom-width: 2px;
    border-bottom-color: rgb(255, 65, 85);
}

.enemy-health-track {
    width: 100%;
    height: 12px;
    background-color: rgb(55, 30, 40);
    overflow: hidden;
}

.enemy-health-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(235, 55, 75);
}

.enemy-health-text {
    color: rgb(235, 235, 245);
    font-size: 12px;
    margin-top: 4px;
    -unity-text-align: middle-center;
}

.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
}

.crosshair-top {
    position: absolute;
    left: -1px;
    top: -14px;
    width: 2px;
    height: 9px;
    background-color: rgb(100, 225, 255);
}

.crosshair-bottom {
    position: absolute;
    left: -1px;
    top: 5px;
    width: 2px;
    height: 9px;
    background-color: rgb(100, 225, 255);
}

.crosshair-left {
    position: absolute;
    left: -14px;
    top: -1px;
    width: 9px;
    height: 2px;
    background-color: rgb(100, 225, 255);
}

.crosshair-right {
    position: absolute;
    left: 5px;
    top: -1px;
    width: 9px;
    height: 2px;
    background-color: rgb(100, 225, 255);
}

.crosshair-center {
    position: absolute;
    left: -2px;
    top: -2px;
    width: 4px;
    height: 4px;
    background-color: rgb(255, 255, 255);
}

.dash-panel {
    position: absolute;
    right: 35px;
    bottom: 35px;
    min-width: 190px;
    padding: 12px;
    align-items: flex-end;
    background-color: rgba(8, 18, 32, 0.88);
    border-right-width: 3px;
    border-right-color: rgb(40, 180, 255);
}

.dash-text {
    color: rgb(100, 225, 255);
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.dash-text.cooldown {
    color: rgb(255, 190, 80);
}

.dash-text.ready {
    color: rgb(100, 225, 255);
}
