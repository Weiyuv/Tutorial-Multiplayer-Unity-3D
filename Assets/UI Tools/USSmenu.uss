
#Root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgb(8, 14, 27);
    align-items: center;
    justify-content: center;
}

#Title {
    color: rgb(255, 255, 255);
    font-size: 46px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 35px;
}

#MenuButtons {
    width: 320px;
    align-items: stretch;
}

Button {
    width: 100%;
    height: 58px;
    margin-bottom: 14px;
    background-color: rgb(17, 35, 58);
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 3px;
    border-right-width: 1px;
    border-top-color: rgb(35, 75, 110);
    border-bottom-color: rgb(35, 75, 110);
    border-left-color: rgb(40, 180, 255);
    border-right-color: rgb(35, 75, 110);
}

#PlayButton {
    background-color: rgb(10, 100, 165);
    border-left-color: rgb(100, 220, 255);
}

Button:hover {
    background-color: rgb(25, 90, 140);
    color: rgb(255, 255, 255);
}
